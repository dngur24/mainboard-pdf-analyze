<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Motherboard PCIe Lane Sharing Info</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>AMD Motherboard PCIe Checker</h1>
      <p class="subtitle">메인보드 모델을 선택하여 PCIe 레인 공유 내역을 확인하세요.</p>
    </header>

    <div class="search-container">
      <input type="text" id="search-input" placeholder="메인보드 모델명 검색 (예: B650, Strix...)" onkeyup="filterBoards()">
    </div>

    <div class="mb-grid" id="mb-grid">
      <!-- 데이터를 로드 중입니다... -->
    </div>
  </div>

  <script>
    let allBoards = [];

    // 데이터를 API에서 가져와서 화면에 그림
    async function loadBoards() {
      try {
        const response = await fetch('/api/motherboards');
        allBoards = await response.json();
        renderBoards(allBoards);
      } catch (error) {
        console.error('Failed to load boards:', error);
        document.getElementById('mb-grid').innerHTML = '<p>데이터를 불러오는 데 실패했습니다.</p>';
      }
    }

    function renderBoards(boards) {
      const grid = document.getElementById('mb-grid');
      grid.innerHTML = boards.map(board => `
        <a href="/motherboard/${encodeURIComponent(board.id)}" class="mb-card" data-name="${board.name.toLowerCase()}">
          <span class="chipset-badge">${board.chipset}</span>
          <h2>${board.name}</h2>
          <p class="subtitle">${board.slots.length} PCIe Slots / ${board.storage.length} M.2 Slots</p>
        </a>
      `).join('');
    }

    function filterBoards() {
      const filter = document.getElementById('search-input').value.toLowerCase();
      const filtered = allBoards.filter(board => 
        board.name.toLowerCase().includes(filter) || 
        board.chipset.toLowerCase().includes(filter)
      );
      renderBoards(filtered);
    }

    // 초기 로드
    loadBoards();
  </script>
</body>
</html>
