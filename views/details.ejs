<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PCIe Details</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <a href="/" class="back-link">← 목록으로 돌아가기</a>
    <header id="board-header" style="text-align: left; margin-bottom: 2rem;">
      <!-- 헤더 정보 로드 중... -->
    </header>

    <div class="details-layout">
      <!-- PCIe Slots -->
      <section>
        <h3>PCIe Expansion Slots</h3>
        <div id="pcie-slots">
          <!-- 로딩 중... -->
        </div>
      </section>

      <!-- M.2 Slots -->
      <section>
        <h3>M.2 Storage Slots</h3>
        <div id="m2-slots">
          <!-- 로딩 중... -->
        </div>
        <div id="conflict-info" class="conflict-desc"></div>
      </section>
    </div>

    <!-- Block Diagram Section -->
    <section class="diagram-section" style="margin-top: 2rem;">
      <h3>System Lane Flow (Block Diagram)</h3>
      <div class="diagram-wrapper">
        <!-- CPU Group -->
        <div class="diagram-group" id="cpu-group">
          <div class="diagram-node cpu">CPU</div>
          <div class="diagram-row" id="cpu-slots-diagram"></div>
        </div>
        
        <!-- Connection to Chipset -->
        <div style="width: 2px; height: 30px; background: var(--border-color);"></div>

        <!-- Chipset Group -->
        <div class="diagram-group" id="chipset-group">
          <div class="diagram-node chipset">Chipset</div>
          <div class="diagram-row" id="chipset-slots-diagram"></div>
        </div>
      </div>
    </section>
  </div>

  <script>
    let boardData = null;
    const initialSlotInfo = {};

    async function loadDetails() {
      const id = window.location.pathname.split('/').pop();
      try {
        const response = await fetch(`/api/motherboards/${encodeURIComponent(decodeURIComponent(id))}`);
        if (!response.ok) throw new Error('Board not found');
        boardData = await response.json();
        
        renderHeader(boardData);
        renderSlots(boardData);
        renderDiagram(boardData);
      } catch (error) {
        console.error('Failed to load details:', error);
        document.body.innerHTML = '<div class="container"><h1>오류</h1><p>데이터를 찾을 수 없습니다.</p><a href="/">홈으로 돌아가기</a></div>';
      }
    }

    function renderHeader(board) {
      document.title = `${board.name} - PCIe Details`;
      const header = document.getElementById('board-header');
      header.innerHTML = `
        <span class="chipset-badge">${board.chipset}</span>
        <h1>${board.name}</h1>
        <p class="subtitle">슬롯을 클릭하여 공유 내역을 확인하세요.</p>
      `;
    }

    function renderSlots(board) {
      const pcieContainer = document.getElementById('pcie-slots');
      const m2Container = document.getElementById('m2-slots');
      
      // slots 필드에서 PCIe만 필터링 (type에 PCIe 포함되거나 storage와 중복되지 않는 것)
      const pcieSlots = board.slots.filter(s => 
        s.type.toLowerCase().includes('pcie') && 
        !board.storage.some(m => m.id === s.id)
      );

      pcieContainer.innerHTML = pcieSlots.map(slot => `
        <div class="slot-item" id="${slot.id}" onclick="toggleM2('${slot.id}')">
          <span class="slot-source">${slot.source}</span>
          <span class="slot-name">${slot.name}</span>
          <span class="slot-type">${slot.type}</span>
        </div>
      `).join('');

      m2Container.innerHTML = board.storage.map(m2 => `
        <div class="slot-item" id="${m2.id}" onclick="toggleM2('${m2.id}')">
          <span class="slot-source">${m2.source}</span>
          <span class="slot-name">${m2.name}</span>
          <span class="slot-type">${m2.type}</span>
        </div>
      `).join('');

      // 초기 상태 저장 (모든 가용 슬롯 합본)
      const allItems = [...new Map(board.slots.concat(board.storage).map(item => [item.id, item])).values()];
      allItems.forEach(slot => {
        initialSlotInfo[slot.id] = {
          name: slot.name,
          type: slot.type
        };
      });
    }

    function renderDiagram(board) {
      const cpuDiagram = document.getElementById('cpu-slots-diagram');
      const chipsetDiagram = document.getElementById('chipset-slots-diagram');

      // 중복 제거된 유니크 슬롯 리스트
      const allItems = [...new Map(board.slots.concat(board.storage).map(item => [item.id, item])).values()];
      
      cpuDiagram.innerHTML = allItems
        .filter(item => item.source.toLowerCase().includes('cpu') || item.source.toLowerCase().includes('processor'))
        .map(item => `<div class="diagram-slot" id="diag-${item.id}">${item.name}</div>`)
        .join('');

      chipsetDiagram.innerHTML = allItems
        .filter(item => item.source.toLowerCase().includes('chipset'))
        .map(item => `<div class="diagram-slot" id="diag-${item.id}">${item.name}</div>`)
        .join('');
    }

    function toggleM2(m2Id) {
      if (!boardData) return;

      const clickedSlot = boardData.slots.concat(boardData.storage).find(s => s.id === m2Id);
      if (!clickedSlot) return;

      // 모든 슬롯 및 다이어그램 초기화
      document.querySelectorAll('.slot-item, .diagram-slot').forEach(el => {
        el.classList.remove('active', 'disabled-slot', 'warning-slot', 'disabled', 'warning');
        
        // 슬롯 텍스트 복구 (상세 리스트만)
        if (el.classList.contains('slot-item')) {
          const info = initialSlotInfo[el.id];
          if (info) {
            el.querySelector('.slot-name').innerText = info.name;
            const typeEl = el.querySelector('.slot-type');
            if (typeEl) typeEl.innerText = info.type;
          }
        }
      });

      const infoBox = document.getElementById('conflict-info');
      infoBox.style.display = 'none';
      infoBox.innerText = '';

      // 선택된 슬롯 활성화
      const activeSlot = document.getElementById(m2Id);
      const activeDiagSlot = document.getElementById(`diag-${m2Id}`);
      if (activeSlot) activeSlot.classList.add('active');
      if (activeDiagSlot) activeDiagSlot.classList.add('active');

      // 공유 규칙 확인 (ID 또는 Name으로 매칭)
      const activeRules = boardData.sharingRules.filter(r => 
        r.trigger === m2Id || r.trigger === clickedSlot.name
      );
      
      if (activeRules.length > 0) {
        infoBox.style.display = 'block';
        activeRules.forEach(rule => {
          // Impact 대상 찾기 (ID 또는 Name으로)
          const targetSlot = boardData.slots.concat(boardData.storage).find(s => 
            s.id === rule.impact || s.name === rule.impact
          );

          if (targetSlot) {
            const targetEl = document.getElementById(targetSlot.id);
            const diagTargetEl = document.getElementById(`diag-${targetSlot.id}`);
            
            if (targetEl) {
              if (rule.effect.toLowerCase().includes('disabled')) {
                targetEl.classList.add('disabled-slot');
                targetEl.querySelector('.slot-name').innerText += " (비활성화됨)";
                if (diagTargetEl) diagTargetEl.classList.add('disabled');
              } else if (rule.effect.toLowerCase().includes('reduced') || rule.newSpeed) {
                targetEl.classList.add('warning-slot');
                const typeEl = targetEl.querySelector('.slot-type');
                if (typeEl) typeEl.innerText = `속도 저하: ${rule.newSpeed || '제한됨'}`;
                if (diagTargetEl) diagTargetEl.classList.add('warning');
              }
            }
          }
          infoBox.innerText += rule.description + "\n";
        });
      } else {
        infoBox.style.display = 'block';
        infoBox.innerText = "이 슬롯은 다른 PCIe 슬롯과 대역폭을 공유하지 않습니다.";
      }
    }

    // 데이터 로드 시작
    loadDetails();
  </script>
</body>
</html>
